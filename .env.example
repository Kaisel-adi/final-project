# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345

# Database Configuration (MongoDB Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gcir_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gcir_db
DATABASE_NAME=gcir_db

# Verification & Proximity Settings
VERIFY_THRESHOLD=10
PROXIMITY_FLAG_RADIUS_KM=5.0
NEARBY_FEED_DEFAULT_RADIUS_KM=5.0

# Cron & Background Job Security
CRON_SECRET_TOKEN=change-me-to-a-secure-random-token

# Image Storage (Cloudinary or local)
# Set USE_CLOUDINARY=False for local file storage in development
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Dispatcher (Resend, SendGrid, or Mock for local development)
# EMAIL_BACKEND options: mock, resend, sendgrid, smtp
EMAIL_BACKEND=mock
EMAIL_FROM="GCIR Civic Alerts <alerts@example.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
