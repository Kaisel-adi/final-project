# Copy to .env and fill in. Never commit the real .env.

FLASK_SECRET_KEY=change-me
FLASK_ENV=development

# MongoDB Atlas connection string (see PRD §9 — free tier)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/gcir?retryWrites=true&w=majority

# Cloudinary (or similar) for photo storage — PRD §5.1, §9
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email API for digests only — PRD §5.5, §9
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Shared secret for external cron -> /jobs/* endpoints — PRD §7, §11 Security
JOBS_SECRET_TOKEN=change-me-too

# Verification threshold — configurable per pilot area, PRD §4
VERIFY_THRESHOLD=10

# Soft proximity check radius for upvoter's last known location (km) — PRD §4
UPVOTE_PROXIMITY_KM=5
